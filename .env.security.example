# Local security stack (Keycloak + Cerbos). LOCAL DEMO ONLY.
#   cp .env.security.example .env.security
#   docker compose --env-file .env.security --profile security --profile worker up --build
# Sign in at http://localhost:5173 with a DEMO account from infra/keycloak/README.md.
DB_PORT=5432
APP_ENV=development
DEMO_MODE=true          # keeps the time-travel control for the demo; set false to hide it
DEMO_AUTH=false         # X-Demo-* headers are refused; Bearer tokens only
AUTHZ_ENGINE=cerbos
CERBOS_URL=http://cerbos:3592
# The issuer is what the browser sees; the backend fetches keys over the internal network.
OIDC_ISSUER=http://localhost:8081/realms/awoc
OIDC_AUDIENCE=awoc-api
OIDC_JWKS_URL=http://keycloak:8080/realms/awoc/protocol/openid-connect/certs
OIDC_CLIENT_ID=awoc-ui
SMTP_HOST=mailpit
SMTP_PORT=1025
