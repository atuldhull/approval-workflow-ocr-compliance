{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "application_id",
    "deficiency_id",
    "round_no",
    "items"
  ],
  "properties": {
    "application_id": {
      "type": "string",
      "format": "uuid"
    },
    "deficiency_id": {
      "type": "string",
      "format": "uuid"
    },
    "round_no": {
      "type": "integer",
      "minimum": 1
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "item_key"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "format": "uuid"
          },
          "item_key": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        }
      }
    }
  }
}
