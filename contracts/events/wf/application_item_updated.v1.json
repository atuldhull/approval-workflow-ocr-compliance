{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "wf.application_item_updated v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "application_id",
    "item_key",
    "state",
    "document_ref"
  ],
  "properties": {
    "application_id": {
      "type": "string",
      "format": "uuid"
    },
    "item_key": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "state": {
      "type": "string",
      "enum": [
        "PROVIDED",
        "MISSING"
      ]
    },
    "document_ref": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    }
  }
}
