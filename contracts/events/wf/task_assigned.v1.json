{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "application_id",
    "committee_id",
    "task_id",
    "title_key",
    "assignee_user_ref"
  ],
  "properties": {
    "application_id": {
      "type": "string",
      "format": "uuid"
    },
    "committee_id": {
      "type": "string",
      "format": "uuid"
    },
    "task_id": {
      "type": "string",
      "format": "uuid"
    },
    "title_key": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "assignee_user_ref": {
      "type": "string",
      "format": "uuid"
    }
  }
}
