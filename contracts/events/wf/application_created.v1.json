{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "wf.application_created v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["application_id", "institution_id", "category", "academic_year"],
  "properties": {
    "application_id": {"type": "string", "format": "uuid"},
    "institution_id": {"type": "string", "format": "uuid"},
    "category": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "academic_year": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"}
  }
}
