{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "application_id",
    "deficiency_id",
    "item_id",
    "state",
    "decided_by"
  ],
  "properties": {
    "application_id": {
      "type": "string",
      "format": "uuid"
    },
    "deficiency_id": {
      "type": "string",
      "format": "uuid"
    },
    "item_id": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "type": "string",
      "enum": [
        "ACCEPTED",
        "REJECTED"
      ]
    },
    "decided_by": {
      "type": "string",
      "format": "uuid"
    }
  }
}
