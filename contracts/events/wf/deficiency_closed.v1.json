{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "application_id",
    "deficiency_id",
    "round_no"
  ],
  "properties": {
    "application_id": {
      "type": "string",
      "format": "uuid"
    },
    "deficiency_id": {
      "type": "string",
      "format": "uuid"
    },
    "round_no": {
      "type": "integer",
      "minimum": 1
    }
  }
}
