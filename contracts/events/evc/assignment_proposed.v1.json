{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "application_id",
    "request_id",
    "assignment_id",
    "run_id",
    "slot_id",
    "date",
    "slot_part",
    "expert_ids",
    "ruleset_key",
    "request_status",
    "simulation_status",
    "selector_policy_version",
    "source_status"
  ],
  "properties": {
    "application_id": {
      "type": "string",
      "format": "uuid"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "assignment_id": {
      "type": "string",
      "format": "uuid"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "slot_id": {
      "type": "string",
      "format": "uuid"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "slot_part": {
      "enum": [
        "AM",
        "PM"
      ]
    },
    "expert_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "ruleset_key": {
      "type": "string",
      "pattern": "^[a-z0-9-]+@[A-Za-z0-9-]+$"
    },
    "request_status": {
      "const": "PROPOSED"
    },
    "simulation_status": {
      "const": "SIMULATED"
    },
    "selector_policy_version": {
      "const": "DEMO_SELECTOR_V1"
    },
    "source_status": {
      "const": "DEMO_ASSUMPTION"
    }
  }
}
