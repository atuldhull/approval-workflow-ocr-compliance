{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "doc.document_scanned v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_id", "version_id", "sha256", "verdict", "scanner"],
  "properties": {
    "document_id": {"type": "string", "format": "uuid"},
    "version_id": {"type": "string", "format": "uuid"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "verdict": {"type": "string", "enum": ["CLEAN", "INFECTED"]},
    "scanner": {"type": "string", "enum": ["clamav"]},
    "signature": {"type": "string", "maxLength": 200, "description": "malware signature name; only when INFECTED"}
  }
}
