{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "doc.fact_confirmed v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["fact_id", "document_id", "version_id", "application_id", "field", "value_hash"],
  "properties": {
    "fact_id": {"type": "string", "format": "uuid"},
    "document_id": {"type": "string", "format": "uuid"},
    "version_id": {"type": "string", "format": "uuid"},
    "application_id": {"type": "string", "format": "uuid"},
    "field": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "value_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
