{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dl.alert_raised v1",
  "description": "A deadline alert level was raised for a role group. VACANT means the group had no members, so nothing was queued and the ladder moved on. No names or contact details.",
  "type": "object",
  "additionalProperties": false,
  "required": ["alert_id", "deadline_id", "level", "role", "due_version", "status"],
  "properties": {
    "alert_id": {"type": "string", "format": "uuid"},
    "deadline_id": {"type": "string", "format": "uuid"},
    "level": {"type": "integer", "minimum": 0, "maximum": 9},
    "role": {"type": "string", "enum": ["INSTITUTION", "SCRUTINY_COMMITTEE", "RO_OFFICER", "BUREAU_OFFICER", "BUREAU_HEAD"]},
    "due_version": {"type": "integer", "minimum": 1},
    "status": {"type": "string", "enum": ["OPEN", "VACANT"]}
  }
}
