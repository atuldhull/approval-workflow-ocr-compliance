{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dl.alert_escalated v1",
  "description": "An alert moved to the next level of the configured ladder, because the previous role group was vacant or its window passed unacknowledged.",
  "type": "object",
  "additionalProperties": false,
  "required": ["alert_id", "from_alert_id", "deadline_id", "from_level", "to_level", "role", "due_version", "reason"],
  "properties": {
    "alert_id": {"type": "string", "format": "uuid"},
    "from_alert_id": {"type": "string", "format": "uuid"},
    "deadline_id": {"type": "string", "format": "uuid"},
    "from_level": {"type": "integer", "minimum": 0, "maximum": 9},
    "to_level": {"type": "integer", "minimum": 1, "maximum": 9},
    "role": {"type": "string", "enum": ["INSTITUTION", "SCRUTINY_COMMITTEE", "RO_OFFICER", "BUREAU_OFFICER", "BUREAU_HEAD"]},
    "due_version": {"type": "integer", "minimum": 1},
    "reason": {"type": "string", "enum": ["VACANCY", "WINDOW_ELAPSED"]}
  }
}
