{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dl.deadline_opened v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["deadline_id", "subject_type", "subject_id", "rule_id", "clock_kind", "clock_owner", "due_date", "ruleset_rev"],
  "properties": {
    "deadline_id": {"type": "string", "format": "uuid"},
    "subject_type": {"type": "string", "pattern": "^[a-z_]+$"},
    "subject_id": {"type": "string", "format": "uuid"},
    "rule_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "clock_kind": {"type": "string", "enum": ["LEGAL", "INTERNAL"]},
    "clock_owner": {"type": "string", "enum": ["AICTE", "INSTITUTION", "COMMITTEE"]},
    "due_date": {"type": "string", "format": "date"},
    "ruleset_rev": {"type": "string", "pattern": "^[a-z0-9-]+@[A-Za-z0-9-]+$"}
  }
}
