{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cmp.letter_registered v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["letter_id", "application_id", "institution_id", "letter_type", "academic_year", "issue_date",
               "issue_date_source", "issue_date_fact_id", "document_version_id", "f_no_sha256", "lists_deficiencies",
               "ruleset_rev"],
  "properties": {
    "letter_id": {"type": "string", "format": "uuid"},
    "application_id": {"type": "string", "format": "uuid"},
    "institution_id": {"type": "string", "format": "uuid"},
    "letter_type": {"type": "string", "enum": ["LOA", "EOA", "LOD", "LOR", "CORRIGENDUM"]},
    "academic_year": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
    "issue_date": {"type": "string", "format": "date"},
    "issue_date_source": {"type": "string", "enum": ["PORTAL_EVENT", "CONFIRMED_FACT"]},
    "issue_date_fact_id": {"type": ["string", "null"], "format": "uuid"},
    "document_version_id": {"type": ["string", "null"], "format": "uuid"},
    "f_no_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "lists_deficiencies": {"type": "boolean"},
    "ruleset_rev": {"type": "string", "pattern": "^[a-z0-9-]+@[A-Za-z0-9-]+$"}
  }
}
