{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cmp.obligation_created v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["obligation_id", "application_id", "institution_id", "kind", "source_letter_id", "source_clause",
               "source_status", "state_origin", "rule_id", "deadline_id", "due_date", "document_id",
               "document_version_id", "doc_type", "valid_until", "validity_basis", "eoa_stop_year", "live_lease_ok"],
  "properties": {
    "obligation_id": {"type": "string", "format": "uuid"},
    "application_id": {"type": "string", "format": "uuid"},
    "institution_id": {"type": "string", "format": "uuid"},
    "kind": {"type": "string", "enum": ["UNDERTAKING", "AFFIDAVIT", "LETTER_CONDITION", "DEPOSIT", "DOCUMENT_VALIDITY",
                                        "RECURRING_FILING"]},
    "source_letter_id": {"type": ["string", "null"], "format": "uuid"},
    "source_clause": {"type": ["string", "null"], "pattern": "^[0-9A-Za-z.()/ -]{1,32}$"},
    "source_status": {"type": "string", "enum": ["verified", "verified_letter_text", "demo_assumption"]},
    "state_origin": {"type": "string", "enum": ["OFFICER_CONFIRMED", "RULE_DEFAULT"]},
    "rule_id": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]*$"},
    "deadline_id": {"type": ["string", "null"], "format": "uuid"},
    "due_date": {"type": ["string", "null"], "format": "date"},
    "document_id": {"type": ["string", "null"], "format": "uuid"},
    "document_version_id": {"type": ["string", "null"], "format": "uuid"},
    "doc_type": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]{0,63}$"},
    "valid_until": {"type": ["string", "null"], "format": "date"},
    "validity_basis": {"type": ["string", "null"], "enum": ["DOCUMENT_FACT", "OFFICER_RECORDED", "APH_PERIOD", null]},
    "eoa_stop_year": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}$"},
    "live_lease_ok": {"type": ["boolean", "null"]}
  }
}
