# Copy to .env and adjust. Never commit .env.
POSTGRES_USER=awoc
POSTGRES_PASSWORD=awoc
POSTGRES_DB=awoc
DB_PORT=5432

# Used when running the backend directly on your laptop (outside Docker)
DATABASE_URL=postgresql+psycopg://awoc:awoc@localhost:5432/awoc

# Demo switches. Both must be false in any real deployment.
DEMO_MODE=true
DEMO_AUTH=true

DEFAULT_RULESET=aph-2024-27@r1
